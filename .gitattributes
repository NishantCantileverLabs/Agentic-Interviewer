# Normalize line endings: LF in the repo, native in working copies where it
# matters. Silences the CRLF warning storm on Windows dev machines.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.css text eol=lf
*.mjs text eol=lf
*.conf text eol=lf
*.txt text eol=lf
*.svg text eol=lf
Dockerfile text eol=lf
