# ── LLM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic    # anthropic | openrouter
ANTHROPIC_API_KEY=
# OpenRouter alternative: set LLM_PROVIDER=openrouter and use OpenRouter
# model slugs (e.g. CONDUCT_MODEL=anthropic/claude-haiku-4.5).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CONDUCT_MODEL=anthropic/claude-haiku-4.5
# Model IDs verified against live Anthropic docs at T0 (2026-08-23).
# Haiku-class conduct model / Opus-class eval model per PHASE1_ARCHITECTURE.md D2.
CONDUCT_MODEL=claude-haiku-4-5
EVAL_MODEL=claude-opus-5
PROMPT_CACHE_ENABLED=true

# ── Voice (T1) ──────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
DEEPGRAM_ENDPOINTING_MS=500
TTS_PRIMARY=deepgram      # deepgram | elevenlabs | cartesia (others become fallbacks)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ── Turn-taking (T1) ────────────────────────────────────────────────
# semantic = local ONNX turn model (needs CPU headroom); stt = Deepgram-native
# endpointing (lightest); vad = silence only. Silence hold ceilings are
# per-round-type plugin values (agent/engine/rounds/*), not env vars.
TURN_DETECTOR=stt         # semantic | stt | vad
# Speculative generation cannot help while the agent injects a per-turn
# engine directive (observation/hint policy): LiveKit discards any
# speculative call whose user message changed afterwards. Measured: 68
# invalidations, 0 uses. Leave false unless that hook is removed.
SPECULATIVE_GENERATION=false

# ── Agent worker ────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── T10 tenancy (Phase 2) ───────────────────────────────────────────
CANDIDATE_LINK_SECRET=dev-candidate-secret-change-me
CANDIDATE_LINK_TTL_H=24
INTERNAL_API_KEY=dev-internal-key
DEV_DEFAULT_ORG=false     # opt-in dev convenience: anonymous callers act as default-org admin
# CLERK_SECRET_KEY=       # plug in at app/tenancy.py::_resolve_headers seam
# CLERK_PUBLISHABLE_KEY=

# ── Accounts (login / signup) ───────────────────────────────────────
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_H=168
OTP_TTL_MIN=10
# Google sign-in: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials with authorized JS origin
# http://localhost:3000, then set BOTH of these to the same client id:
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Brand + candidate-facing contact (baked into the frontend at build)
NEXT_PUBLIC_ORG_NAME=AI Interview
NEXT_PUBLIC_CONTACT_EMAIL=talent@example.dev

# ── T11 lifecycle (Phase 2) ─────────────────────────────────────────
RESEND_API_KEY=           # invite emails; dev-logs when unset
EMAIL_FROM=interviews@example.dev
APP_BASE_URL=http://localhost:3000
RESCHEDULE_MAX=2
RESCHEDULE_CUTOFF_H=2
ORG_MAX_CONCURRENT_SESSIONS_DEFAULT=5
CONSENT_POLICY_VERSION=2026-08-23.1

# ── Deployment posture ──────────────────────────────────────────────
# "production" refuses to boot with any dev-default secret, disables the
# X-Org-Id dev auth stub, and never returns OTPs in API responses.
# The boot checklist prints exactly which variable blocked it.
ENVIRONMENT=dev
# extra allowed browser origins beyond APP_BASE_URL (comma-separated)
CORS_EXTRA_ORIGINS=
# production only: the one email allowed to claim the first-admin bootstrap
FIRST_ADMIN_EMAIL=
# self-serve practice interviews (isolated in the demo org)
DEMO_ENABLED=true

# ── Infra ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview
# alembic runs as the table owner (compose sets this; defaults to DATABASE_URL)
MIGRATIONS_DATABASE_URL=
# compose parameterization (dev defaults; production must override all four)
POSTGRES_PASSWORD=interview
APP_DB_PASSWORD=app_user_dev_pass
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=recordings
JUDGE0_URL=http://localhost:2358
# shared AUTHN token: judge0 refuses unauthenticated submissions when set;
# required by the production boot check
JUDGE0_AUTH_TOKEN=
EXEC_CPU_LIMIT_S=5
EXEC_MEM_MB=256

# ── Frontend (baked at build time) ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_YWS_URL=ws://localhost:1234

# ── Eval ────────────────────────────────────────────────────────────
EVAL_QUEUE=evaluate_session
RETENTION_DAYS_DEFAULT=90
